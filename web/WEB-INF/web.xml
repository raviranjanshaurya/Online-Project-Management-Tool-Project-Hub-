<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="https://jakarta.ee/xml/ns/jakartaee" version="6.0">
  <display-name>Project Hub Ultimate</display-name>
  <servlet>
    <servlet-name>ProjectApp</servlet-name>
    <servlet-class>ProjectApp</servlet-class>
  </servlet>
  <!-- Empty-string mapping handles only the context root; Tomcat's default servlet serves static CSS/JS. -->
  <servlet-mapping>
    <servlet-name>ProjectApp</servlet-name>
    <url-pattern></url-pattern>
  </servlet-mapping>
</web-app>
